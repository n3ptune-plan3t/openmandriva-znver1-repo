+name: Build builder image
+
+# Weekly rebuild of the pre-synced OpenMandriva builder image, plus
+# on-demand (workflow_dispatch) and as a reusable workflow so build.yml
+# can create the image on the very first run when it does not exist yet.
+on:
+  schedule:
+    - cron: '0 3 * * 0'      # Sundays, 03:00 UTC
+  workflow_dispatch:
+  workflow_call:
+
+concurrency:
+  group: oma-znver1-builder-image
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+  packages: write
+
+jobs:
+  image:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Compute image name
+        id: meta
+        run: |
+          owner=$(printf '%s' "$GITHUB_REPOSITORY_OWNER" | tr '[:upper:]' '[:lower:]')
+          echo "image=ghcr.io/${owner}/oma-znver1-builder" >> "$GITHUB_OUTPUT"
+          echo "date=$(date -u +%Y-%m-%d)" >> "$GITHUB_OUTPUT"
+
+      - uses: docker/setup-buildx-action@v3
+
+      - name: Log in to GHCR
+        uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      # no-cache + pull: the whole point is a fresh distro-sync, so never
+      # reuse layers from a previous build or an older base image.
+      # provenance: false keeps it to one manifest per push so pruning
+      # untagged versions below really removes the old image.
+      - name: Build and push
+        uses: docker/build-push-action@v6
+        with:
+          context: docker
+          platforms: linux/amd64
+          push: true
+          pull: true
+          no-cache: true
+          provenance: false
+          tags: ${{ steps.meta.outputs.image }}:latest
+          build-args: |
+            BUILD_DATE=${{ steps.meta.outputs.date }}
+          labels: |
+            org.opencontainers.image.source=https://github.com/${{ github.repository }}
+
+      # The previous image loses its :latest tag when the new one is
+      # pushed; delete those untagged leftovers so only one image remains.
+      - name: Remove old image versions
+        continue-on-error: true
+        uses: actions/delete-package-versions@v5
+        with:
+          package-name: oma-znver1-builder
+          package-type: container
+          delete-only-untagged-versions: 'true'
