diff --git a/src/bin/e_config.c b/src/bin/e_config.c
index 5286876..1f9ea40 100644
--- a/src/bin/e_config.c
+++ b/src/bin/e_config.c
@@ -1409,6 +1409,49 @@ while (!e_config)
                e_config->scale.set_xapp_dpi = 1;
                e_config_save_queue();
             }
+          CONFIG_VERSION_CHECK(24)
+            {
+               Eina_List *l;
+               E_Config_Binding_Signal *ebs;
+               Eina_Bool found = EINA_FALSE;
+
+               CONFIG_VERSION_UPDATE_INFO(24);
+               /* middle click on the titlebar: gracefully close the window
+                * (WM_DELETE_WINDOW, so apps can ask to save) instead of the
+                * old default of shading it. User customised bindings are
+                * left alone. */
+               EINA_LIST_FOREACH(e_config->signal_bindings, l, ebs)
+                 {
+                    if ((!ebs->signal) || (!ebs->source) || (!ebs->action))
+                      continue;
+                    if (strcmp(ebs->source, "e.event.titlebar")) continue;
+                    if (strcmp(ebs->signal, "mouse,down,2") &&
+                        strcmp(ebs->signal, "mouse,clicked,2")) continue;
+                    found = EINA_TRUE;
+                    if (!strcmp(ebs->action, "window_shaded_toggle"))
+                      {
+                         eina_stringshare_replace(&ebs->signal, "mouse,clicked,2");
+                         eina_stringshare_replace(&ebs->action, "window_close");
+                         eina_stringshare_replace(&ebs->params, NULL);
+                      }
+                 }
+               if (!found)
+                 {
+                    ebs = E_NEW(E_Config_Binding_Signal, 1);
+                    if (ebs)
+                      {
+                         ebs->context = E_BINDING_CONTEXT_WINDOW;
+                         ebs->signal = eina_stringshare_add("mouse,clicked,2");
+                         ebs->source = eina_stringshare_add("e.event.titlebar");
+                         ebs->modifiers = E_BINDING_MODIFIER_NONE;
+                         ebs->any_mod = 1;
+                         ebs->action = eina_stringshare_add("window_close");
+                         e_config->signal_bindings =
+                           eina_list_append(e_config->signal_bindings, ebs);
+                      }
+                 }
+               e_config_save_queue();
+            }
      }
 
      e_config->config_version = E_CONFIG_FILE_VERSION;
