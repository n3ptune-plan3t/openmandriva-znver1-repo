diff --git a/src/bin/e_border.c b/src/bin/e_border.c
index b4cecf9a6..c6fa760ff 100644
--- a/src/bin/e_border.c
+++ b/src/bin/e_border.c
@@ -1352,0 +1353,18 @@ _e_border_pending_move_resize_add(E_Border *bd,
+static void _e_border_move_resize_internal(E_Border *bd, int x, int y, int w, int h, Eina_Bool without_border, Eina_Bool move);
+
+/* keep windows out of shelves that exclusively reserve their space */
+static Eina_Bool
+_e_border_shelf_exclusive_clamp(E_Border *bd, int *x, int *y, int *w, int *h)
+{
+   Ecore_X_Window_Type t;
+
+   if ((!bd->zone) || (bd->fullscreen) || (bd->client.netwm.state.fullscreen))
+     return EINA_FALSE;
+   if ((bd->maximized & E_MAXIMIZE_TYPE) == E_MAXIMIZE_FULLSCREEN)
+     return EINA_FALSE;
+   t = bd->client.netwm.type;
+   if ((t == ECORE_X_WINDOW_TYPE_DOCK) || (t == ECORE_X_WINDOW_TYPE_DESKTOP))
+     return EINA_FALSE;
+   return e_zone_shelf_exclusive_clamp(bd->zone, x, y, w, h);
+}
+
@@ -1398,0 +1417,11 @@ _e_border_move_internal(E_Border *bd,
+   {
+      int cw = bd->w, ch = bd->h;
+
+      if (_e_border_shelf_exclusive_clamp(bd, &x, &y, &cw, &ch) &&
+          ((cw != bd->w) || (ch != bd->h)))
+        {
+           /* too big to sit next to the shelf: shrink as well */
+           _e_border_move_resize_internal(bd, x, y, cw, ch, 0, 1);
+           return;
+        }
+   }
@@ -1590,0 +1620,12 @@ _e_border_move_resize_internal(E_Border *bd,
+   {
+      int cx = move ? x : bd->x, cy = move ? y : bd->y;
+
+      if (_e_border_shelf_exclusive_clamp(bd, &cx, &cy, &w, &h))
+        {
+           /* a pure resize that must also move the window */
+           if ((!move) && ((cx != bd->x) || (cy != bd->y))) move = 1;
+           x = cx;
+           y = cy;
+        }
+   }
+
