diff --git a/src/bin/e_zone.c b/src/bin/e_zone.c
index 7f4f2d1a2..f0f04afee 100644
--- a/src/bin/e_zone.c
+++ b/src/bin/e_zone.c
@@ -1252,2 +1252,6 @@ _e_zone_useful_geometry_calc(E_Zone *zone)
-             if (shelf->cfg->overlap)
-               continue;
+             /* "exclusive" shelves always reserve their space, even when
+              * they autohide or are marked as overlappable */
+             if (!shelf->cfg->exclusive)
+               {
+                  if (shelf->cfg->overlap)
+                    continue;
@@ -1255,2 +1259,3 @@ _e_zone_useful_geometry_calc(E_Zone *zone)
-             if (shelf->cfg->autohide)
-               continue;
+                  if (shelf->cfg->autohide)
+                    continue;
+               }
@@ -1324,0 +1330,119 @@ _e_zone_useful_geometry_calc(E_Zone *zone)
+static Eina_Bool
+_e_zone_shelf_exclusive_active(E_Zone *zone, E_Shelf *shelf)
+{
+   E_Config_Shelf_Desk *sd;
+   Eina_List *l;
+
+   if ((shelf->zone != zone) || (!shelf->cfg) || (!shelf->cfg->exclusive))
+     return EINA_FALSE;
+   if (!shelf->cfg->desk_show_mode) return EINA_TRUE;
+   EINA_LIST_FOREACH(shelf->cfg->desk_list, l, sd)
+     if ((sd) && (sd->x == zone->desk_x_current) &&
+         (sd->y == zone->desk_y_current))
+       return EINA_TRUE;
+   return EINA_FALSE;
+}
+
+/**
+ * Push a window rectangle (zone relative border geometry, absolute
+ * coordinates) out of every shelf that exclusively reserves its space, so
+ * that no window ends up over or under it. The rectangle is also shrunk if
+ * it is too large to fit next to the shelf. Returns EINA_TRUE if it changed.
+ */
+EAPI Eina_Bool
+e_zone_shelf_exclusive_clamp(E_Zone *zone, int *x, int *y, int *w, int *h)
+{
+   Eina_List *shelves;
+   E_Shelf *shelf;
+   Eina_Bool changed = EINA_FALSE;
+
+   if ((!zone) || (!x) || (!y) || (!w) || (!h)) return EINA_FALSE;
+   shelves = e_shelf_list_all();
+   EINA_LIST_FREE(shelves, shelf)
+     {
+        int rx, ry, rw, rh, avail;
+
+        if (!_e_zone_shelf_exclusive_active(zone, shelf)) continue;
+        rx = zone->x + shelf->x;
+        ry = zone->y + shelf->y;
+        rw = shelf->w;
+        rh = shelf->h;
+        if (!E_INTERSECTS(*x, *y, *w, *h, rx, ry, rw, rh)) continue;
+
+        switch (shelf->cfg->orient)
+          {
+           case E_GADCON_ORIENT_TOP:
+           case E_GADCON_ORIENT_CORNER_TL:
+           case E_GADCON_ORIENT_CORNER_TR:
+             avail = zone->h - rh;
+             if (*h > avail) *h = avail;
+             *y = ry + rh;
+             break;
+
+           case E_GADCON_ORIENT_BOTTOM:
+           case E_GADCON_ORIENT_CORNER_BL:
+           case E_GADCON_ORIENT_CORNER_BR:
+             avail = zone->h - rh;
+             if (*h > avail) *h = avail;
+             *y = ry - *h;
+             break;
+
+           case E_GADCON_ORIENT_LEFT:
+           case E_GADCON_ORIENT_CORNER_LT:
+           case E_GADCON_ORIENT_CORNER_LB:
+             avail = zone->w - rw;
+             if (*w > avail) *w = avail;
+             *x = rx + rw;
+             break;
+
+           case E_GADCON_ORIENT_RIGHT:
+           case E_GADCON_ORIENT_CORNER_RT:
+           case E_GADCON_ORIENT_CORNER_RB:
+             avail = zone->w - rw;
+             if (*w > avail) *w = avail;
+             *x = rx - *w;
+             break;
+
+           default:
+             {
+                /* floating shelf: leave by the nearest side */
+                int up = (*y + *h) - ry, down = (ry + rh) - *y;
+                int left = (*x + *w) - rx, right = (rx + rw) - *x;
+                int m = up;
+
+                if (down < m) m = down;
+                if (left < m) m = left;
+                if (right < m) m = right;
+                if (m == up) *y = ry - *h;
+                else if (m == down) *y = ry + rh;
+                else if (m == left) *x = rx - *w;
+                else *x = rx + rw;
+             }
+             break;
+          }
+        changed = EINA_TRUE;
+     }
+   return changed;
+}
+
+/**
+ * Re-apply the exclusive shelf rules to every window of a zone (after the
+ * shelf configuration changed).
+ */
+EAPI void
+e_zone_shelf_exclusive_refit(E_Zone *zone)
+{
+   Eina_List *l;
+   E_Border *bd;
+
+   EINA_LIST_FOREACH(e_border_client_list(), l, bd)
+     {
+        if (bd->zone != zone) continue;
+        /* maximized/fullscreen windows follow the useful geometry; a plain
+         * move_resize would unmaximize them */
+        if ((bd->maximized) || (bd->fullscreen)) continue;
+        /* the clamp runs inside the move/resize calls */
+        e_border_move_resize(bd, bd->x, bd->y, bd->w, bd->h);
+     }
+}
+
@@ -1361,0 +1486,17 @@ e_zone_useful_geometry_get(E_Zone *zone,
+static Ecore_Job *_exclusive_refit_job = NULL;
+
+static void
+_e_zone_exclusive_refit_job(void *data __UNUSED__)
+{
+   Eina_List *l, *ll, *lz;
+   E_Manager *man;
+   E_Container *con;
+   E_Zone *zone;
+
+   _exclusive_refit_job = NULL;
+   EINA_LIST_FOREACH(e_manager_list(), l, man)
+     EINA_LIST_FOREACH(man->containers, ll, con)
+       EINA_LIST_FOREACH(con->zones, lz, zone)
+         e_zone_shelf_exclusive_refit(zone);
+}
+
@@ -1380,0 +1522,18 @@ e_zone_useful_geometry_dirty(E_Zone *zone)
+
+   /* A shelf was created, resized or reconfigured: windows that were placed
+    * before its final size was known (e.g. restored at login) must be pushed
+    * out of an exclusive shelf now, not only when next moved. Deferred so it
+    * never runs inside the shelf's own update. */
+   if (!_exclusive_refit_job)
+     {
+        Eina_List *sl, *shelves = e_shelf_list_all();
+        E_Shelf *sh;
+        Eina_Bool any = EINA_FALSE;
+
+        EINA_LIST_FOREACH(shelves, sl, sh)
+          if ((sh->zone == zone) && (sh->cfg) && (sh->cfg->exclusive))
+            any = EINA_TRUE;
+        eina_list_free(shelves);
+        if (any)
+          _exclusive_refit_job = ecore_job_add(_e_zone_exclusive_refit_job, NULL);
+     }
