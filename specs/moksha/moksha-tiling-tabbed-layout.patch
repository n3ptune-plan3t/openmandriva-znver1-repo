 /* }}} */
+/* Tabs {{{*/
+
+#define TILING_TAB_HEIGHT    22
+#define TILING_TAB_FONT      11
+#define TILING_TAB_PAD       6
+#define TILING_TAB_FONT_NAME "Sans"
+
+typedef struct _Tab_Item {
+    E_Border    *bd;
+    Evas_Object *frame, *fill, *clip, *label;
+} Tab_Item;
+
+struct _Tab_Bar {
+    E_Popup   *popup;
+    Eina_List *items;
+    E_Border  *active;
+};
+
+enum {
+    TAB_FOCUSED,
+    TAB_ACTIVE,
+    TAB_UNFOCUSED,
+    TAB_URGENT
+};
+
+/* i3's default colors: border, background, text */
+static const struct {
+    int border, fill, text;
+} _tab_colors[] = {
+    { 0x285577, 0x4c7899, 0xffffff },  /* focused */
+    { 0x333333, 0x5f676a, 0xffffff },  /* visible tab of an unfocused stack */
+    { 0x333333, 0x222222, 0x888888 },  /* unfocused */
+    { 0x2f343a, 0x900000, 0xffffff },  /* urgent */
+};
+
+static void _tabs_schedule(void);
+
+static int
+_tab_bar_height(void)
+{
+    int h = (int)(TILING_TAB_HEIGHT * e_scale);
+
+    return MAX(h, 8);
+}
+
+static Eina_Bool
+_tab_stack_is_tabbed(const Tiling_Info *tinfo, int stack)
+{
+    return tinfo->conf && tinfo->conf->tabbed
+        && tinfo->stacks[stack] && tinfo->stacks[stack]->next;
+}
+
+/* The area of a stack, tab bar included. */
+static void
+_tab_stack_rect(const Tiling_Info *tinfo, int stack,
+                int *x, int *y, int *w, int *h)
+{
+    int zx, zy, zw, zh;
+
+    e_zone_useful_geometry_get(tinfo->desk->zone, &zx, &zy, &zw, &zh);
+    if (tinfo->conf->use_rows) {
+        *x = zx;
+        *y = tinfo->pos[stack];
+        *w = zw;
+        *h = tinfo->size[stack];
+    } else {
+        *x = tinfo->pos[stack];
+        *y = zy;
+        *w = tinfo->size[stack];
+        *h = zh;
+    }
+}
+
+/* The visible tab of a stack: the focused window if it is in there,
+ * otherwise the one that was focused last. */
+static E_Border *
+_tab_active_get(Eina_List *stack)
+{
+    E_Border *focused = e_border_focused_get(), *bd, *first = NULL;
+    Eina_List *l;
+
+    EINA_LIST_FOREACH(stack, l, bd) {
+        Border_Extra *extra;
+
+        if (bd == focused)
+            return bd;
+        extra = eina_hash_find(_G.border_extras, &bd);
+        if (extra && extra->tab_active && !first)
+            first = bd;
+    }
+    return first ? first : eina_list_data_get(stack);
+}
+
+static void
+_tab_active_set(int stack, E_Border *active)
+{
+    Eina_List *l;
+    E_Border *bd;
+
+    EINA_LIST_FOREACH(_G.tinfo->stacks[stack], l, bd) {
+        Border_Extra *extra = eina_hash_find(_G.border_extras, &bd);
+
+        if (extra)
+            extra->tab_active = (bd == active);
+    }
+}
+
+static void
+_tab_focus(E_Border *bd)
+{
+    if (bd->iconic)
+        e_border_uniconify(bd);
+    e_border_raise(bd);
+    e_border_focus_set(bd, 1, 1);
+}
+
+/* Next/previous visible tab inside one stack, wrapping around. */
+static void
+_tab_step_stack(int stack, int dir)
+{
+    Eina_List *l, *vis = NULL;
+    E_Border *bd, *cur, *next = NULL;
+    int n, idx = -1;
+
+    cur = _tab_active_get(_G.tinfo->stacks[stack]);
+    EINA_LIST_FOREACH(_G.tinfo->stacks[stack], l, bd) {
+        if (bd->iconic)
+            continue;
+        if (bd == cur)
+            idx = eina_list_count(vis);
+        vis = eina_list_append(vis, bd);
+    }
+    n = eina_list_count(vis);
+    if (n > 1 && idx >= 0)
+        next = eina_list_nth(vis, (((idx + dir) % n) + n) % n);
+    eina_list_free(vis);
+
+    if (next && next != cur)
+        _tab_focus(next);
+}
+
+/* Like i3's "focus left/right" inside a tabbed container: step through the
+ * tabs of the focused stack, then carry on into the next stack (landing on
+ * its visible tab). On desks that are not tabbed, or when the focus is not
+ * on a tiled window, behave like the taskbar-order action so that gesture
+ * bindings keep working everywhere. */
+static void
+_tab_focus_step(int dir)
+{
+    E_Desk *desk = get_current_desk();
+    E_Border *cur = e_border_focused_get();
+    E_Action *act;
+
+    check_tinfo(desk);
+    if (_G.tinfo->conf && _G.tinfo->conf->tabbed && cur
+        && (get_stack(cur) >= 0)) {
+        Eina_List *l, *all = NULL;
+        E_Border *bd, *next;
+        int i, n, idx = -1, cs = get_stack(cur);
+
+        for (i = 0; i < TILING_MAX_STACKS; i++) {
+            EINA_LIST_FOREACH(_G.tinfo->stacks[i], l, bd) {
+                if (bd->iconic)
+                    continue;
+                if (bd == cur)
+                    idx = eina_list_count(all);
+                all = eina_list_append(all, bd);
+            }
+        }
+        n = eina_list_count(all);
+        if (n > 1 && idx >= 0) {
+            next = eina_list_nth(all, (((idx + dir) % n) + n) % n);
+            if (get_stack(next) != cs)
+                next = _tab_active_get(_G.tinfo->stacks[get_stack(next)]);
+            eina_list_free(all);
+            if (next && next != cur)
+                _tab_focus(next);
+            return;
+        }
+        eina_list_free(all);
+    }
+
+    act = e_action_find((dir > 0) ? "tasks_focus_next" : "tasks_focus_prev");
+    if (act && act->func.go)
+        act->func.go(E_OBJECT(e_util_zone_current_get(e_manager_current_get())),
+                     NULL);
+}
+
+static void
+_tab_bar_clear(Tab_Bar *bar)
+{
+    Tab_Item *it;
+
+    EINA_LIST_FREE(bar->items, it) {
+        evas_object_del(it->label);
+        evas_object_del(it->clip);
+        evas_object_del(it->fill);
+        evas_object_del(it->frame);
+        free(it);
+    }
+}
+
+static void
+_tab_bar_hide(Tab_Bar *bar)
+{
+    if (!bar)
+        return;
+    _tab_bar_clear(bar);
+    bar->active = NULL;
+    if (bar->popup)
+        e_popup_hide(bar->popup);
+}
+
+static void
+_tab_bar_free(Tab_Bar *bar)
+{
+    if (!bar)
+        return;
+    _tab_bar_clear(bar);
+    if (bar->popup)
+        e_object_del(E_OBJECT(bar->popup));
+    free(bar);
+}
+
+static void
+_tab_color_set(Evas_Object *o, int rgb)
+{
+    evas_object_color_set(o, (rgb >> 16) & 0xff, (rgb >> 8) & 0xff,
+                          rgb & 0xff, 255);
+}
+
+static void
+_tab_cb_down(void *data, Evas *e __UNUSED__, Evas_Object *obj __UNUSED__,
+             void *event_info)
+{
+    Tab_Item *it = data;
+    Evas_Event_Mouse_Down *ev = event_info;
+
+    if (ev->button != 1)
+        return;
+    if (!eina_hash_find(_G.border_extras, &it->bd))
+        return;
+    _tab_focus(it->bd);
+}
+
+/* scrolling over the bar switches tabs, like in i3 */
+static void
+_tab_cb_wheel(void *data, Evas *e __UNUSED__, Evas_Object *obj __UNUSED__,
+              void *event_info)
+{
+    Tab_Item *it = data;
+    Evas_Event_Mouse_Wheel *ev = event_info;
+    int stack;
+
+    if (!it->bd->desk || !eina_hash_find(_G.border_extras, &it->bd))
+        return;
+    check_tinfo(it->bd->desk);
+    stack = get_stack(it->bd);
+    if (stack < 0)
+        return;
+    _tab_step_stack(stack, (ev->z > 0) ? 1 : -1);
+}
+
+static void
+_tab_bar_draw(Tab_Bar *bar, Eina_List *stack, int w, int h)
+{
+    Evas *evas = bar->popup->evas;
+    E_Border *focused = e_border_focused_get(), *bd;
+    Eina_List *l;
+    int n = eina_list_count(stack), i = 0;
+    int fs = MAX((int)(TILING_TAB_FONT * e_scale), 6);
+    int pad = (int)(TILING_TAB_PAD * e_scale);
+
+    _tab_bar_clear(bar);
+
+    EINA_LIST_FOREACH(stack, l, bd) {
+        Tab_Item *it;
+        const char *title;
+        int state, tx, tw, th;
+
+        /* equal widths, the last tab takes the rounding remainder */
+        tw = w / n;
+        tx = i * tw;
+        if (i == (n - 1))
+            tw = w - tx;
+        i++;
+
+        it = E_NEW(Tab_Item, 1);
+        if (!it)
+            continue;
+        it->bd = bd;
+
+        if (bd != focused && bd->client.icccm.urgent)
+            state = TAB_URGENT;
+        else if (bd == focused)
+            state = TAB_FOCUSED;
+        else if (bd == bar->active)
+            state = TAB_ACTIVE;
+        else
+            state = TAB_UNFOCUSED;
+
+        it->frame = evas_object_rectangle_add(evas);
+        _tab_color_set(it->frame, _tab_colors[state].border);
+        evas_object_move(it->frame, tx, 0);
+        evas_object_resize(it->frame, tw, h);
+        evas_object_event_callback_add(it->frame, EVAS_CALLBACK_MOUSE_DOWN,
+                                       _tab_cb_down, it);
+        evas_object_event_callback_add(it->frame, EVAS_CALLBACK_MOUSE_WHEEL,
+                                       _tab_cb_wheel, it);
+        evas_object_show(it->frame);
+
+        it->fill = evas_object_rectangle_add(evas);
+        _tab_color_set(it->fill, _tab_colors[state].fill);
+        evas_object_move(it->fill, tx + 1, 1);
+        evas_object_resize(it->fill, MAX(tw - 2, 1), MAX(h - 2, 1));
+        evas_object_pass_events_set(it->fill, 1);
+        evas_object_show(it->fill);
+
+        it->clip = evas_object_rectangle_add(evas);
+        evas_object_color_set(it->clip, 255, 255, 255, 255);
+        evas_object_move(it->clip, tx + pad, 1);
+        evas_object_resize(it->clip, MAX(tw - (2 * pad), 1), MAX(h - 2, 1));
+        evas_object_pass_events_set(it->clip, 1);
+        evas_object_show(it->clip);
+
+        title = e_border_name_get(bd);
+        it->label = evas_object_text_add(evas);
+        evas_object_text_style_set(it->label, EVAS_TEXT_STYLE_PLAIN);
+        evas_object_text_font_set(it->label, TILING_TAB_FONT_NAME, fs);
+        evas_object_text_text_set(it->label, title ? title : "");
+        _tab_color_set(it->label, _tab_colors[state].text);
+        evas_object_geometry_get(it->label, NULL, NULL, NULL, &th);
+        evas_object_move(it->label, tx + pad, (h - th) / 2);
+        evas_object_clip_set(it->label, it->clip);
+        evas_object_pass_events_set(it->label, 1);
+        evas_object_show(it->label);
+
+        bar->items = eina_list_append(bar->items, it);
+    }
+}
+
+static void
+_tabs_refresh_tinfo(Tiling_Info *tinfo)
+{
+    Eina_Bool shown;
+    int i, bh = _tab_bar_height();
+
+    shown = tinfo->desk
+        && (e_desk_current_get(tinfo->desk->zone) == tinfo->desk);
+
+    for (i = 0; i < TILING_MAX_STACKS; i++) {
+        Tab_Bar *bar = tinfo->bars[i];
+        E_Zone *zone;
+        E_Border *active;
+        int x, y, w, h;
+
+        if (!shown || !_tab_stack_is_tabbed(tinfo, i)) {
+            _tab_bar_hide(bar);
+            continue;
+        }
+
+        zone = tinfo->desk->zone;
+        _tab_stack_rect(tinfo, i, &x, &y, &w, &h);
+        if (w < 1) {
+            _tab_bar_hide(bar);
+            continue;
+        }
+
+        if (!bar) {
+            bar = E_NEW(Tab_Bar, 1);
+            if (!bar)
+                continue;
+            tinfo->bars[i] = bar;
+        }
+        if (!bar->popup) {
+            bar->popup = e_popup_new(zone, x - zone->x, y - zone->y, w, bh);
+            if (!bar->popup)
+                continue;
+            e_popup_name_set(bar->popup, "tiling_tabs");
+            e_popup_layer_set(bar->popup, E_LAYER_BELOW);
+        }
+        e_popup_move_resize(bar->popup, x - zone->x, y - zone->y, w, bh);
+
+        active = _tab_active_get(tinfo->stacks[i]);
+        if (active && bar->active != active)
+            e_border_raise(active);
+        bar->active = active;
+
+        _tab_bar_draw(bar, tinfo->stacks[i], w, bh);
+        e_popup_show(bar->popup);
+    }
+}
+
+static Eina_Bool
+_tabs_foreach_cb(const Eina_Hash *hash __UNUSED__, const void *key __UNUSED__,
+                 void *data, void *fdata __UNUSED__)
+{
+    _tabs_refresh_tinfo(data);
+
+    return true;
+}
