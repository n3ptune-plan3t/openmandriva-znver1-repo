+static void
+_tabs_job_cb(void *data __UNUSED__)
+{
+    _G.tabs_job = NULL;
+    if (!_G.info_hash)
+        return;
+    eina_hash_foreach(_G.info_hash, _tabs_foreach_cb, NULL);
+}
+
+/* Everything that changes the tabs (layout, focus, titles, desk switch)
+ * only asks for a redraw, which then happens once per main loop iteration. */
+static void
+_tabs_schedule(void)
+{
+    if (_G.tabs_job)
+        return;
+    _G.tabs_job = ecore_job_add(_tabs_job_cb, NULL);
+}
+
+/* All windows of a tabbed stack share the stack's area, minus the tab bar
+ * on top. Only the raised one is visible. */
+static void
+_reorganize_stack_tabbed(int stack)
+{
+    Eina_List *l;
+    int sx, sy, sw, sh, bh = _tab_bar_height();
+
+    _tab_stack_rect(_G.tinfo, stack, &sx, &sy, &sw, &sh);
+
+    for (l = _G.tinfo->stacks[stack]; l; l = l->next) {
+        E_Border *bd = l->data;
+        Border_Extra *extra;
+
+        extra = eina_hash_find(_G.border_extras, &bd);
+        if (!extra) {
+            ERR("No extra for %p", bd);
+            continue;
+        }
+
+        if (bd->maximized)
+            _e_border_unmaximize(bd, E_MAXIMIZE_BOTH);
+
+        extra->expected.x = sx;
+        extra->expected.y = sy + bh;
+        extra->expected.w = sw;
+        extra->expected.h = MAX(sh - bh, 1);
+
+        _e_border_move_resize(bd,
+                              extra->expected.x,
+                              extra->expected.y,
+                              extra->expected.w,
+                              extra->expected.h);
+    }
+
+    _tabs_schedule();
+}
+
+static Eina_Bool
+_tab_focus_hook(void *data __UNUSED__, int type,
+                E_Event_Border_Focus_In *ev)
+{
+    E_Border *bd = ev->border;
+    int stack;
+
+    if (!bd || !bd->desk)
+        return true;
+
+    check_tinfo(bd->desk);
+    if (!_G.tinfo->conf || !_G.tinfo->conf->tabbed)
+        return true;
+
+    stack = get_stack(bd);
+    if (stack < 0)
+        return true;
+
+    if (type == E_EVENT_BORDER_FOCUS_IN)
+        _tab_active_set(stack, bd);
+    _tabs_schedule();
+
+    return true;
+}
+
+/* titles and urgency live in the border properties */
+static Eina_Bool
+_tab_property_hook(void *data __UNUSED__, int type __UNUSED__,
+                   E_Event_Border_Property *ev)
+{
+    E_Border *bd = ev->border;
+
+    if (!bd || !bd->desk)
+        return true;
+    if (!eina_hash_find(_G.border_extras, &bd))
+        return true;
+
+    check_tinfo(bd->desk);
+    if (_G.tinfo->conf && _G.tinfo->conf->tabbed && (get_stack(bd) >= 0))
+        _tabs_schedule();
+
+    return true;
+}
