@@ -206,0 +228,58 @@ e_modapi_init(E_Module *m)
+/* Actions used by touchpad gestures (tpgest) and key bindings: focus the
+ * window to the right/left of the focused one, in the order of the icons
+ * the Tasks gadget of the current screen shows on the shelf. */
+static void
+_tasks_focus_step(int dir)
+{
+   E_Zone *zone = e_util_zone_current_get(e_manager_current_get());
+   Eina_List *l, *vis = NULL;
+   Tasks *tasks, *use = NULL;
+   Tasks_Item *item;
+   E_Border *cur = e_border_focused_get(), *bd;
+   int n, idx = -1, i = 0;
+
+   if ((!tasks_config) || (!zone)) return;
+   EINA_LIST_FOREACH(tasks_config->tasks, l, tasks)
+     if ((tasks->zone == zone) && (tasks->items))
+       {
+          use = tasks;
+          break;
+       }
+   if (!use) return;
+
+   /* icons in shelf order; minimized windows are not woken up by a swipe */
+   EINA_LIST_FOREACH(use->items, l, item)
+     if ((item->border) && (!item->border->iconic))
+       vis = eina_list_append(vis, item->border);
+   n = eina_list_count(vis);
+   if (n == 0) return;
+
+   EINA_LIST_FOREACH(vis, l, bd)
+     {
+        if (bd == cur) idx = i;
+        i++;
+     }
+   if (idx < 0) idx = (dir > 0) ? -1 : n;
+   idx = (((idx + dir) % n) + n) % n;
+   bd = eina_list_nth(vis, idx);
+   eina_list_free(vis);
+   if ((!bd) || (bd == cur)) return;
+
+   if ((!bd->sticky) && (use->config) && (use->config->show_all))
+     e_desk_show(bd->desk);
+   e_border_raise(bd);
+   e_border_focus_set(bd, 1, 1);
+}
+
+static void
+_tasks_act_next(E_Object *obj __UNUSED__, const char *params __UNUSED__)
+{
+   _tasks_focus_step(1);
+}
+
+static void
+_tasks_act_prev(E_Object *obj __UNUSED__, const char *params __UNUSED__)
+{
+   _tasks_focus_step(-1);
+}
+
@@ -209,0 +289,5 @@ e_modapi_shutdown(E_Module *m __UNUSED__)
+   e_action_predef_name_del("Tasks", "Focus Next Window (taskbar order)");
+   e_action_predef_name_del("Tasks", "Focus Previous Window (taskbar order)");
+   e_action_del("tasks_focus_next");
+   e_action_del("tasks_focus_prev");
+
diff --git a/src/modules/tpgest/e_mod_config.c b/src/modules/tpgest/e_mod_config.c
new file mode 100644
index 000000000..afe3e6bae
--- /dev/null
+++ b/src/modules/tpgest/e_mod_config.c
@@ -0,0 +1,382 @@
+#include "e.h"
+#include "e_mod_main.h"
+
+typedef struct
+{
+   int         type, fingers, dir;
+   const char *label;
+} Gesture_Def;
+
+/* how the action list is grouped (like Moksha's own binding dialogs) */
+enum { GRP_DESKTOP, GRP_TASKBAR, GRP_WINDOW, GRP_MENU, GRP_OTHER, GRP_LAST };
+
+static const char *_group_names[GRP_LAST] =
+{
+   N_("Desktop"), N_("Taskbar order"), N_("Window"), N_("Menus"), N_("Other")
+};
+
+typedef struct
+{
+   const char *label;
+   const char *action;
+   const char *params;
+   int         group;
+} Preset;
+
+static const Gesture_Def _gestures[] =
+{
+   { TPG_SWIPE, 3, TPG_UP,    N_("Swipe up") },
+   { TPG_SWIPE, 3, TPG_DOWN,  N_("Swipe down") },
+   { TPG_SWIPE, 3, TPG_LEFT,  N_("Swipe left") },
+   { TPG_SWIPE, 3, TPG_RIGHT, N_("Swipe right") },
+   { TPG_PINCH, 3, TPG_IN,    N_("Pinch in") },
+   { TPG_PINCH, 3, TPG_OUT,   N_("Pinch out") },
+   { TPG_SWIPE, 4, TPG_UP,    N_("Swipe up") },
+   { TPG_SWIPE, 4, TPG_DOWN,  N_("Swipe down") },
+   { TPG_SWIPE, 4, TPG_LEFT,  N_("Swipe left") },
+   { TPG_SWIPE, 4, TPG_RIGHT, N_("Swipe right") },
+   { TPG_PINCH, 4, TPG_IN,    N_("Pinch in") },
+   { TPG_PINCH, 4, TPG_OUT,   N_("Pinch out") }
+};
+#define N_GESTURES ((int)(sizeof(_gestures) / sizeof(_gestures[0])))
+
+static const Preset _presets[] =
+{
+   { N_("None"),                       "",                        NULL,   GRP_OTHER },
+   { N_("Previous Desktop"),           "desk_flip_by",            "-1 0", GRP_DESKTOP },
+   { N_("Next Desktop"),               "desk_flip_by",            "1 0",  GRP_DESKTOP },
+   { N_("Desktop Above"),              "desk_flip_by",            "0 -1", GRP_DESKTOP },
+   { N_("Desktop Below"),              "desk_flip_by",            "0 1",  GRP_DESKTOP },
+   { N_("Show Desktop"),               "desk_deskshow_toggle",    NULL,   GRP_DESKTOP },
+   { N_("Main Menu"),                  "menu_show",               "main", GRP_MENU },
+   { N_("Window List"),                "winlist",                 "next", GRP_MENU },
+   { N_("Toggle Maximize"),            "window_maximized_toggle", NULL,   GRP_WINDOW },
+   { N_("Minimize"),                   "window_iconic_toggle",    NULL,   GRP_WINDOW },
+   { N_("Close"),                      "window_close",            NULL,   GRP_WINDOW },
+   { N_("Send to Previous Desktop"),   "window_desk_move_by",     "-1 0", GRP_WINDOW },
+   { N_("Send to Next Desktop"),       "window_desk_move_by",     "1 0",  GRP_WINDOW },
+   { N_("Focus Right Window"),         "tasks_focus_next",        NULL,   GRP_TASKBAR },
+   { N_("Focus Left Window"),          "tasks_focus_prev",        NULL,   GRP_TASKBAR },
+   { N_("Run Command"),                "exec",                    NULL,   GRP_OTHER }
+};
+#define N_PRESETS ((int)(sizeof(_presets) / sizeof(_presets[0])))
+#define PRESET_EXEC (N_PRESETS - 1)
+
+#define PRESET_KEEP N_PRESETS   /* binding that matches no preset: left alone */
+
+typedef struct _Cb_Item Cb_Item;
+
+struct _Cb_Item
+{
+   E_Config_Dialog_Data *cfdata;
+   int                   val;
+};
+
+struct _E_Config_Dialog_Data
+{
+   int          enabled;
+   int          swipe_threshold, pinch_threshold;
+   int          sel[N_GESTURES];      /* chosen preset per gesture */
+   char        *cmd[N_GESTURES];      /* command for "Run Command" */
+   int          row[N_GESTURES];      /* row of each gesture in the list */
+   int          arow[N_PRESETS + 1];  /* row of each action in its list */
+   int          cur;                  /* gesture being edited */
+   char        *cmd_edit;             /* entry buffer */
+   Evas_Object *o_gest, *o_act, *o_cmd;
+   Cb_Item      gitem[N_GESTURES];
+   Cb_Item      aitem[N_PRESETS + 1];
+};
+
+static void        *_create_data(E_Config_Dialog *cfd);
+static void         _free_data(E_Config_Dialog *cfd, E_Config_Dialog_Data *cfdata);
+static Evas_Object *_basic_create(E_Config_Dialog *cfd, Evas *evas, E_Config_Dialog_Data *cfdata);
+static int          _basic_apply(E_Config_Dialog *cfd, E_Config_Dialog_Data *cfdata);
+static int          _basic_check(E_Config_Dialog *cfd, E_Config_Dialog_Data *cfdata);
+
+E_Config_Dialog *
+e_int_config_tpgest(E_Container *con, const char *params __UNUSED__)
+{
+   E_Config_Dialog_View *v;
+
+   if (e_config_dialog_find("E", "keyboard_and_mouse/touchpad_gestures"))
+     return NULL;
+   v = E_NEW(E_Config_Dialog_View, 1);
+   if (!v) return NULL;
+   v->create_cfdata = _create_data;
+   v->free_cfdata = _free_data;
+   v->basic.create_widgets = _basic_create;
+   v->basic.apply_cfdata = _basic_apply;
+   v->basic.check_changed = _basic_check;
+   return e_config_dialog_new(con, _("Touchpad Gesture Settings"), "E",
+                              "keyboard_and_mouse/touchpad_gestures",
+                              "preferences-desktop-mouse", 0, v, NULL);
+}
+
+static int
+_preset_find(const char *action, const char *params)
+{
+   int i;
+
+   if ((!action) || (!action[0])) return 0;
+   if (!strcmp(action, "exec")) return PRESET_EXEC;
+   for (i = 1; i < PRESET_EXEC; i++)
+     {
+        if (strcmp(_presets[i].action, action)) continue;
+        if ((!_presets[i].params) && ((!params) || (!params[0]))) return i;
+        if ((_presets[i].params) && (params) &&
+            (!strcmp(_presets[i].params, params))) return i;
+     }
+   return PRESET_KEEP;
+}
+
+static void
+_fill_data(E_Config_Dialog_Data *cfdata)
+{
+   int i;
+
+   cfdata->enabled = tpg_config->enabled;
+   cfdata->swipe_threshold = tpg_config->swipe_threshold;
+   cfdata->pinch_threshold = tpg_config->pinch_threshold;
+   for (i = 0; i < N_GESTURES; i++)
+     {
+        Tpg_Binding *b = tpg_binding_find(_gestures[i].type,
+                                          _gestures[i].fingers,
+                                          _gestures[i].dir);
+        const char *a = b ? b->action : NULL;
+        const char *p = b ? b->params : NULL;
+
+        cfdata->sel[i] = _preset_find(a, p);
+        cfdata->cmd[i] = strdup((cfdata->sel[i] == PRESET_EXEC) && p ? p : "");
+        cfdata->gitem[i].cfdata = cfdata;
+        cfdata->gitem[i].val = i;
+     }
+   for (i = 0; i <= N_PRESETS; i++)
+     {
+        cfdata->aitem[i].cfdata = cfdata;
+        cfdata->aitem[i].val = i;
+     }
+}
+
+static void *
+_create_data(E_Config_Dialog *cfd __UNUSED__)
+{
+   E_Config_Dialog_Data *cfdata = E_NEW(E_Config_Dialog_Data, 1);
+
+   if (!cfdata) return NULL;
+   _fill_data(cfdata);
+   return cfdata;
+}
+
+static void
+_free_data(E_Config_Dialog *cfd __UNUSED__, E_Config_Dialog_Data *cfdata)
+{
+   int i;
+
+   for (i = 0; i < N_GESTURES; i++)
+     {
+        free(cfdata->cmd[i]);
+     }
+   free(cfdata->cmd_edit);
+   E_FREE(cfdata);
+}
+
+static void
+_sync_cmd(E_Config_Dialog_Data *cfdata)
+{
+   int i = cfdata->cur;
+
+   e_widget_disabled_set(cfdata->o_cmd, cfdata->sel[i] != PRESET_EXEC);
+}
+
+/* a gesture was picked on the left: show its action on the right */
+static void
+_cb_gesture(void *data)
+{
+   Cb_Item *it = data;
+   E_Config_Dialog_Data *cfdata = it->cfdata;
+
+   cfdata->cur = it->val;
+   e_widget_ilist_selected_set(cfdata->o_act, cfdata->arow[cfdata->sel[it->val]]);
+   e_widget_entry_text_set(cfdata->o_cmd, cfdata->cmd[it->val]);
+   _sync_cmd(cfdata);
+}
+
+/* an action was picked on the right: assign it to the chosen gesture */
+static void
+_cb_action(void *data)
+{
+   Cb_Item *it = data;
+   E_Config_Dialog_Data *cfdata = it->cfdata;
+
+   cfdata->sel[cfdata->cur] = it->val;
+   _sync_cmd(cfdata);
+}
+
+static void
+_cb_cmd(void *data, void *data2 __UNUSED__)
+{
+   E_Config_Dialog_Data *cfdata = data;
+   int i = cfdata->cur;
+
+   free(cfdata->cmd[i]);
+   cfdata->cmd[i] = strdup(cfdata->cmd_edit ? cfdata->cmd_edit : "");
+}
+
+static Evas_Object *
+_basic_create(E_Config_Dialog *cfd __UNUSED__, Evas *evas, E_Config_Dialog_Data *cfdata)
+{
+   Evas_Object *ol, *ot, *of, *ow;
+   int i, p, g, row, fingers = 0;
+
+   ol = e_widget_list_add(evas, 0, 0);
+   ow = e_widget_check_add(evas, _("Enable touchpad gestures"), &(cfdata->enabled));
+   e_widget_list_object_append(ol, ow, 1, 0, 0.0);
+
+   ot = e_widget_table_add(evas, 0);
+
+   /* left: the gestures, grouped by finger count */
+   of = e_widget_framelist_add(evas, _("Gestures"), 0);
+   cfdata->o_gest = e_widget_ilist_add(evas, 0, 0, NULL);
+   e_widget_ilist_freeze(cfdata->o_gest);
+   row = 0;
+   for (i = 0; i < N_GESTURES; i++)
+     {
+        if (_gestures[i].fingers != fingers)
+          {
+             fingers = _gestures[i].fingers;
+             e_widget_ilist_header_append(cfdata->o_gest, NULL,
+                                          (fingers == 3) ? _("3 Fingers") : _("4 Fingers"));
+             row++;
+          }
+        e_widget_ilist_append(cfdata->o_gest, NULL, _(_gestures[i].label), _cb_gesture,
+                              &(cfdata->gitem[i]), NULL);
+        cfdata->row[i] = row++;
+     }
+   e_widget_ilist_go(cfdata->o_gest);
+   e_widget_ilist_thaw(cfdata->o_gest);
+   e_widget_size_min_set(cfdata->o_gest, 420, 360);
+   e_widget_framelist_object_append(of, cfdata->o_gest);
+   e_widget_table_object_append(ot, of, 0, 0, 1, 2, 1, 1, 1, 1);
+
+   /* right: the actions, grouped like Moksha's own binding dialogs */
+   of = e_widget_framelist_add(evas, _("Action"), 0);
+   cfdata->o_act = e_widget_ilist_add(evas, 0, 0, NULL);
+   e_widget_ilist_freeze(cfdata->o_act);
+   row = 0;
+   for (g = 0; g < GRP_LAST; g++)
+     {
+        Eina_Bool head = EINA_FALSE;
+
+        for (p = 0; p < N_PRESETS; p++)
+          {
+             if (_presets[p].group != g) continue;
+             if (!head)
+               {
+                  e_widget_ilist_header_append(cfdata->o_act, NULL, _(_group_names[g]));
+                  row++;
+                  head = EINA_TRUE;
+               }
+             e_widget_ilist_append(cfdata->o_act, NULL, _(_presets[p].label),
+                                   _cb_action, &(cfdata->aitem[p]), NULL);
+             cfdata->arow[p] = row++;
+          }
+     }
+   e_widget_ilist_append(cfdata->o_act, NULL, _("Custom (leave unchanged)"),
+                         _cb_action, &(cfdata->aitem[PRESET_KEEP]), NULL);
+   cfdata->arow[PRESET_KEEP] = row++;
+   e_widget_ilist_go(cfdata->o_act);
+   e_widget_ilist_thaw(cfdata->o_act);
+   e_widget_size_min_set(cfdata->o_act, 420, 270);
+   e_widget_framelist_object_append(of, cfdata->o_act);
+   e_widget_table_object_append(ot, of, 1, 0, 1, 1, 1, 1, 1, 1);
+
+   of = e_widget_framelist_add(evas, _("Action Params"), 0);
+   cfdata->o_cmd = e_widget_entry_add(evas, &(cfdata->cmd_edit), _cb_cmd,
+                                      cfdata, NULL);
+   e_widget_size_min_set(cfdata->o_cmd, 420, 28);
+   e_widget_framelist_object_append(of, cfdata->o_cmd);
+   ow = e_widget_label_add(evas, _("Command to run (only for \"Run Command\")"));
+   e_widget_framelist_object_append(of, ow);
+   e_widget_table_object_append(ot, of, 1, 1, 1, 1, 1, 0, 1, 0);
+
+   e_widget_list_object_append(ol, ot, 1, 1, 0.5);
+
+   /* sensitivity, side by side */
+   of = e_widget_framelist_add(evas, _("Sensitivity"), 0);
+   ow = e_widget_label_add(evas, _("Swipe distance"));
+   e_widget_framelist_object_append(of, ow);
+   ow = e_widget_slider_add(evas, 1, 0, _("%1.0f units"), 5, 400, 1, 0,
+                            NULL, &(cfdata->swipe_threshold), 300);
+   e_widget_framelist_object_append(of, ow);
+   ow = e_widget_label_add(evas, _("Pinch size change"));
+   e_widget_framelist_object_append(of, ow);
+   ow = e_widget_slider_add(evas, 1, 0, _("%1.0f %%"), 1, 200, 1, 0,
+                            NULL, &(cfdata->pinch_threshold), 300);
+   e_widget_framelist_object_append(of, ow);
+   e_widget_list_object_append(ol, of, 1, 0, 0.5);
+
+   /* every row shows its current action, then start on the first gesture */
+   e_widget_ilist_selected_set(cfdata->o_gest, cfdata->row[0]);
+   return ol;
+}
+
+static int
+_basic_check(E_Config_Dialog *cfd __UNUSED__, E_Config_Dialog_Data *cfdata)
+{
+   int i;
+
+   if ((cfdata->enabled != tpg_config->enabled) ||
+       (cfdata->swipe_threshold != tpg_config->swipe_threshold) ||
+       (cfdata->pinch_threshold != tpg_config->pinch_threshold))
+     return 1;
+   for (i = 0; i < N_GESTURES; i++)
+     {
+        Tpg_Binding *b = tpg_binding_find(_gestures[i].type, _gestures[i].fingers,
+                                          _gestures[i].dir);
+        int cur = b ? _preset_find(b->action, b->params) : 0;
+
+        if (cfdata->sel[i] != cur) return 1;
+        if ((cur == PRESET_EXEC) &&
+            strcmp(cfdata->cmd[i], (b && b->params) ? b->params : ""))
+          return 1;
+     }
+   return 0;
+}
+
+static int
+_basic_apply(E_Config_Dialog *cfd __UNUSED__, E_Config_Dialog_Data *cfdata)
+{
+   int i;
+
+   tpg_config->enabled = cfdata->enabled;
+   tpg_config->swipe_threshold = cfdata->swipe_threshold;
+   tpg_config->pinch_threshold = cfdata->pinch_threshold;
+
+   for (i = 0; i < N_GESTURES; i++)
+     {
+        int s = cfdata->sel[i];
+
+        if (s == PRESET_KEEP) continue;
+        if (s == PRESET_EXEC)
+          tpg_binding_set(_gestures[i].type, _gestures[i].fingers,
+                          _gestures[i].dir, "exec", cfdata->cmd[i]);
+        else
+          tpg_binding_set(_gestures[i].type, _gestures[i].fingers,
+                          _gestures[i].dir, _presets[s].action,
+                          _presets[s].params);
+     }
+
+   tpg_config_save();
+
+   if (tpg_config->enabled)
+     {
+        if (!tpg_gesture_running() && !tpg_gesture_start())
+          e_util_dialog_show(_("Touchpad Gestures"),
+                             _("No accessible touchpad was found.<br>"
+                               "Make sure your user can read /dev/input "
+                               "(for example by joining the 'input' group)."));
+     }
+   else
+     tpg_gesture_stop();
+   return 1;
+}
diff --git a/src/modules/tpgest/e_mod_gesture.c b/src/modules/tpgest/e_mod_gesture.c
