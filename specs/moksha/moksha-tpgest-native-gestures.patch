index 000000000..ddfa4773e
--- /dev/null
+++ b/src/modules/tpgest/e_mod_gesture.c
@@ -0,0 +1,215 @@
+/* Native touchpad gesture engine.
+ *
+ * Recognition logic is taken from tpgestd (n3ptune-plan3t/tpgestd): libinput
+ * gesture events, unaccelerated swipe deltas, scale for pinch. Instead of
+ * forking a shell command, the libinput fd is watched by Moksha's own main
+ * loop (no thread, no timer, no separate process) and gestures call Moksha
+ * actions directly.
+ */
+#include "e.h"
+#include "e_mod_main.h"
+#include <libinput.h>
+#include <libudev.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <math.h>
+
+static struct udev *_udev = NULL;
+static struct libinput *_li = NULL;
+static Ecore_Fd_Handler *_fdh = NULL;
+
+static double _acc_dx = 0.0, _acc_dy = 0.0, _scale = 1.0;
+static int _fingers = 0;
+
+static int
+_open_restricted(const char *path, int flags, void *data __UNUSED__)
+{
+   int fd = open(path, flags | O_CLOEXEC);
+   return (fd < 0) ? -errno : fd;
+}
+
+static void
+_close_restricted(int fd, void *data __UNUSED__)
+{
+   close(fd);
+}
+
+static const struct libinput_interface _iface =
+{
+   _open_restricted,
+   _close_restricted
+};
+
+static void
+_dispatch(int type, int fingers, int dir)
+{
+   Tpg_Binding *b;
+   E_Action *act;
+
+   b = tpg_binding_find(type, fingers, dir);
+   if ((!b) || (!b->action) || (!b->action[0])) return;
+   act = e_action_find(b->action);
+   if ((!act) || (!act->func.go)) return;
+   /* zone object: zone actions use it, window actions fall back to the
+    * focused window by themselves */
+   act->func.go(E_OBJECT(e_util_zone_current_get(e_manager_current_get())),
+                b->params);
+}
+
+static void
+_handle_swipe(struct libinput_event *ev, enum libinput_event_type t)
+{
+   struct libinput_event_gesture *g = libinput_event_get_gesture_event(ev);
+
+   if (t == LIBINPUT_EVENT_GESTURE_SWIPE_BEGIN)
+     {
+        _acc_dx = _acc_dy = 0.0;
+        _fingers = libinput_event_gesture_get_finger_count(g);
+     }
+   else if (t == LIBINPUT_EVENT_GESTURE_SWIPE_UPDATE)
+     {
+        _acc_dx += libinput_event_gesture_get_dx_unaccelerated(g);
+        _acc_dy += libinput_event_gesture_get_dy_unaccelerated(g);
+     }
+   else if (t == LIBINPUT_EVENT_GESTURE_SWIPE_END)
+     {
+        if (!libinput_event_gesture_get_cancelled(g) &&
+            ((_fingers == 3) || (_fingers == 4)))
+          {
+             double adx = fabs(_acc_dx), ady = fabs(_acc_dy);
+             double th = (double)tpg_config->swipe_threshold;
+
+             if ((adx > th) || (ady > th))
+               {
+                  int dir;
+
+                  if (adx > ady) dir = (_acc_dx > 0) ? TPG_RIGHT : TPG_LEFT;
+                  else dir = (_acc_dy > 0) ? TPG_DOWN : TPG_UP;
+                  _dispatch(TPG_SWIPE, _fingers, dir);
+               }
+          }
+        _fingers = 0;
+     }
+}
+
+static void
+_handle_pinch(struct libinput_event *ev, enum libinput_event_type t)
+{
+   struct libinput_event_gesture *g = libinput_event_get_gesture_event(ev);
+
+   if (t == LIBINPUT_EVENT_GESTURE_PINCH_BEGIN)
+     {
+        _scale = 1.0;
+        _fingers = libinput_event_gesture_get_finger_count(g);
+     }
+   else if (t == LIBINPUT_EVENT_GESTURE_PINCH_UPDATE)
+     {
+        _scale = libinput_event_gesture_get_scale(g);
+     }
+   else if (t == LIBINPUT_EVENT_GESTURE_PINCH_END)
+     {
+        if (!libinput_event_gesture_get_cancelled(g) &&
+            ((_fingers == 3) || (_fingers == 4)))
+          {
+             double delta = _scale - 1.0;
+
+             if (fabs(delta) > ((double)tpg_config->pinch_threshold / 100.0))
+               _dispatch(TPG_PINCH, _fingers, (delta > 0) ? TPG_OUT : TPG_IN);
+          }
+        _fingers = 0;
+     }
+}
+
+static Eina_Bool
+_cb_fd(void *data __UNUSED__, Ecore_Fd_Handler *fdh __UNUSED__)
+{
+   struct libinput_event *ev;
+
+   if (!_li) return ECORE_CALLBACK_CANCEL;
+   libinput_dispatch(_li);
+   while ((ev = libinput_get_event(_li)))
+     {
+        enum libinput_event_type t = libinput_event_get_type(ev);
+
+        switch (t)
+          {
+           case LIBINPUT_EVENT_GESTURE_SWIPE_BEGIN:
+           case LIBINPUT_EVENT_GESTURE_SWIPE_UPDATE:
+           case LIBINPUT_EVENT_GESTURE_SWIPE_END:
+             _handle_swipe(ev, t);
+             break;
+           case LIBINPUT_EVENT_GESTURE_PINCH_BEGIN:
+           case LIBINPUT_EVENT_GESTURE_PINCH_UPDATE:
+           case LIBINPUT_EVENT_GESTURE_PINCH_END:
+             _handle_pinch(ev, t);
+             break;
+           default:
+             break;
+          }
+        libinput_event_destroy(ev);
+     }
+   return ECORE_CALLBACK_RENEW;
+}
+
+Eina_Bool
+tpg_gesture_running(void)
+{
+   return (_li != NULL);
+}
+
+void
+tpg_gesture_stop(void)
+{
+   if (_fdh) ecore_main_fd_handler_del(_fdh);
+   _fdh = NULL;
+   if (_li) libinput_unref(_li);
+   _li = NULL;
+   if (_udev) udev_unref(_udev);
+   _udev = NULL;
+   _fingers = 0;
+}
+
+Eina_Bool
+tpg_gesture_start(void)
+{
+   struct libinput_event *ev;
+   int devices = 0;
+
+   if (_li) return EINA_TRUE;
+
+   _udev = udev_new();
+   if (!_udev) return EINA_FALSE;
+   _li = libinput_udev_create_context(&_iface, NULL, _udev);
+   if (!_li) goto fail;
+   if (libinput_udev_assign_seat(_li, "seat0") != 0) goto fail;
+
+   /* count gesture capable devices (touchpads) that we could open */
+   libinput_dispatch(_li);
+   while ((ev = libinput_get_event(_li)))
+     {
+        if (libinput_event_get_type(ev) == LIBINPUT_EVENT_DEVICE_ADDED)
+          {
+             struct libinput_device *dev = libinput_event_get_device(ev);
+
+             if (libinput_device_has_capability(dev, LIBINPUT_DEVICE_CAP_GESTURE))
+               devices++;
+          }
+        libinput_event_destroy(ev);
+     }
+   if (devices == 0)
+     {
+        fprintf(stderr, "tpgest: no accessible touchpad found "
+                        "(permissions? try adding yourself to the 'input' group)\n");
+        goto fail;
+     }
+
+   _fdh = ecore_main_fd_handler_add(libinput_get_fd(_li), ECORE_FD_READ,
+                                    _cb_fd, NULL, NULL, NULL);
+   if (!_fdh) goto fail;
+   return EINA_TRUE;
+
+fail:
+   tpg_gesture_stop();
+   return EINA_FALSE;
+}
diff --git a/src/modules/tpgest/e_mod_main.c b/src/modules/tpgest/e_mod_main.c
new file mode 100644
index 000000000..b982a71c9
--- /dev/null
+++ b/src/modules/tpgest/e_mod_main.c
@@ -0,0 +1,182 @@
+#include "e.h"
+#include "e_mod_main.h"
+
+EAPI E_Module_Api e_modapi = { E_MODULE_API_VERSION, "Touchpad Gestures" };
+
+Config *tpg_config = NULL;
+static E_Config_DD *conf_edd = NULL;
+static E_Config_DD *bind_edd = NULL;
+
+Tpg_Binding *
+tpg_binding_find(int type, int fingers, int dir)
+{
+   Eina_List *l;
+   Tpg_Binding *b;
+
+   if (!tpg_config) return NULL;
+   EINA_LIST_FOREACH(tpg_config->bindings, l, b)
+     if ((b->type == type) && (b->fingers == fingers) && (b->dir == dir))
+       return b;
+   return NULL;
+}
+
+void
+tpg_binding_set(int type, int fingers, int dir, const char *action, const char *params)
+{
+   Tpg_Binding *b;
+
+   if (!tpg_config) return;
+   b = tpg_binding_find(type, fingers, dir);
+   if (!b)
+     {
+        b = E_NEW(Tpg_Binding, 1);
+        if (!b) return;
+        b->type = type;
+        b->fingers = fingers;
+        b->dir = dir;
+        tpg_config->bindings = eina_list_append(tpg_config->bindings, b);
+     }
+   eina_stringshare_replace(&b->action, action ? action : "");
+   eina_stringshare_replace(&b->params, (params && params[0]) ? params : NULL);
+}
+
+void
+tpg_config_save(void)
+{
+   if (!conf_edd || !tpg_config) return;
+   e_config_domain_save("module.tpgest", conf_edd, tpg_config);
+}
+
+#define TPG_CONFIG_VERSION 2
+
+static void
+_reset_bindings(void)
+{
+   Tpg_Binding *b;
+
+   EINA_LIST_FREE(tpg_config->bindings, b)
+     {
+        eina_stringshare_del(b->action);
+        eina_stringshare_del(b->params);
+        E_FREE(b);
+     }
+}
+
+static void
+_defaults(void)
+{
+   /* Native equivalents of tpgestd's config.example. tpgestd shells out to
+    * xdotool/wmctrl; here the same gestures call Moksha actions directly. */
+   /* 3 fingers left/right: focus the window to the right/left of the
+    * focused one, following the icon order of the Tasks gadget */
+   tpg_binding_set(TPG_SWIPE, 3, TPG_LEFT,  "tasks_focus_next", NULL);
+   tpg_binding_set(TPG_SWIPE, 3, TPG_RIGHT, "tasks_focus_prev", NULL);
+   tpg_binding_set(TPG_SWIPE, 3, TPG_UP,    "menu_show", "main");
+   tpg_binding_set(TPG_SWIPE, 3, TPG_DOWN,  "desk_deskshow_toggle", NULL);
+   /* 4 fingers left/right: switch the desktop (focus moves with the view,
+    * the focused window is NOT carried along). Natural scrolling: the
+    * content follows the fingers, so swiping left reveals the desktop on
+    * the right. */
+   tpg_binding_set(TPG_SWIPE, 4, TPG_LEFT,  "desk_flip_by", "1 0");
+   tpg_binding_set(TPG_SWIPE, 4, TPG_RIGHT, "desk_flip_by", "-1 0");
+   tpg_binding_set(TPG_SWIPE, 4, TPG_UP,    "window_maximized_toggle", NULL);
+   tpg_binding_set(TPG_SWIPE, 4, TPG_DOWN,  "window_iconic_toggle", NULL);
+}
+
+EAPI void *
+e_modapi_init(E_Module *m)
+{
+   bind_edd = E_CONFIG_DD_NEW("Tpgest_Binding", Tpg_Binding);
+#undef T
+#undef D
+#define T Tpg_Binding
+#define D bind_edd
+   E_CONFIG_VAL(D, T, type, INT);
+   E_CONFIG_VAL(D, T, fingers, INT);
+   E_CONFIG_VAL(D, T, dir, INT);
+   E_CONFIG_VAL(D, T, action, STR);
+   E_CONFIG_VAL(D, T, params, STR);
+
+   conf_edd = E_CONFIG_DD_NEW("Tpgest_Config", Config);
+#undef T
+#undef D
+#define T Config
+#define D conf_edd
+   E_CONFIG_VAL(D, T, version, INT);
+   E_CONFIG_VAL(D, T, enabled, INT);
+   E_CONFIG_VAL(D, T, swipe_threshold, INT);
+   E_CONFIG_VAL(D, T, pinch_threshold, INT);
+   E_CONFIG_LIST(D, T, bindings, bind_edd);
+#undef T
+#undef D
+
+   tpg_config = e_config_domain_load("module.tpgest", conf_edd);
+   if (!tpg_config)
+     {
+        tpg_config = E_NEW(Config, 1);
+        tpg_config->version = TPG_CONFIG_VERSION;
+        tpg_config->enabled = 1;
+        tpg_config->swipe_threshold = 40;
+        tpg_config->pinch_threshold = 15;
+        _defaults();
+     }
+   if (tpg_config->version < TPG_CONFIG_VERSION)
+     {
+        /* bindings saved by older versions no longer match the actions
+         * (e.g. 4 fingers used to move the window to another desktop) */
+        _reset_bindings();
+        _defaults();
+        tpg_config->version = TPG_CONFIG_VERSION;
+        tpg_config_save();
+     }
+   E_CONFIG_LIMIT(tpg_config->swipe_threshold, 5, 400);
+   E_CONFIG_LIMIT(tpg_config->pinch_threshold, 1, 200);
+
+   /* the "Input" category is created by conf_interaction; adding it here
+    * is a no-op if it already exists. */
+   e_configure_registry_category_add("keyboard_and_mouse", 40, _("Input"),
+                                     NULL, "preferences-behavior");
+   e_configure_registry_item_add("keyboard_and_mouse/touchpad_gestures", 60,
+                                 _("Touchpad Gestures"), NULL,
+                                 "preferences-desktop-mouse",
+                                 e_int_config_tpgest);
+
+   if (tpg_config->enabled) tpg_gesture_start();
+
+   e_module_delayed_set(m, 1);
+   return m;
+}
+
+EAPI int
+e_modapi_shutdown(E_Module *m __UNUSED__)
+{
+   E_Config_Dialog *cfd;
+   Tpg_Binding *b;
+
+   while ((cfd = e_config_dialog_get("E", "keyboard_and_mouse/touchpad_gestures")))
+     e_object_del(E_OBJECT(cfd));
+   e_configure_registry_item_del("keyboard_and_mouse/touchpad_gestures");
+
+   tpg_gesture_stop();
+
+   if (tpg_config)
+     {
+        EINA_LIST_FREE(tpg_config->bindings, b)
+          {
+             eina_stringshare_del(b->action);
+             eina_stringshare_del(b->params);
+             E_FREE(b);
+          }
+        E_FREE(tpg_config);
+     }
+   E_CONFIG_DD_FREE(conf_edd);
+   E_CONFIG_DD_FREE(bind_edd);
+   return 1;
+}
+
+EAPI int
+e_modapi_save(E_Module *m __UNUSED__)
+{
+   tpg_config_save();
+   return 1;
+}
diff --git a/src/modules/tpgest/e_mod_main.h b/src/modules/tpgest/e_mod_main.h
new file mode 100644
index 000000000..666f262c7
--- /dev/null
+++ b/src/modules/tpgest/e_mod_main.h
@@ -0,0 +1,60 @@
+#ifndef E_MOD_MAIN_H
+#define E_MOD_MAIN_H
+
+/* Native touchpad gestures for Moksha.
+ * Gesture recognition is derived from n3ptune-plan3t/tpgestd (libinput). */
+
+#define TPG_SWIPE 0
+#define TPG_PINCH 1
+
+/* swipe directions */
+#define TPG_UP    0
+#define TPG_DOWN  1
+#define TPG_LEFT  2
+#define TPG_RIGHT 3
+/* pinch directions (share the numbering with up/down, as in tpgestd) */
+#define TPG_IN    0
+#define TPG_OUT   1
+
+typedef struct _Tpg_Binding Tpg_Binding;
+typedef struct _Config      Config;
+
+struct _Tpg_Binding
+{
+   int         type;      /* TPG_SWIPE / TPG_PINCH */
+   int         fingers;   /* 3 or 4 */
+   int         dir;
+   const char *action;    /* Moksha action name (e.g. desk_flip_by); "" = none */
+   const char *params;    /* action params, may be NULL */
+};
+
+struct _Config
+{
+   int        version;          /* bumped when the default bindings change */
+   int        enabled;
+   int        swipe_threshold;  /* accumulated unaccelerated px */
+   int        pinch_threshold;  /* percent scale change */
+   Eina_List *bindings;         /* Tpg_Binding * */
+};
+
+extern Config *tpg_config;
+
+EAPI extern E_Module_Api e_modapi;
+EAPI void *e_modapi_init(E_Module *m);
+EAPI int   e_modapi_shutdown(E_Module *m);
+EAPI int   e_modapi_save(E_Module *m);
+
+/* bindings */
+Tpg_Binding     *tpg_binding_find(int type, int fingers, int dir);
+void             tpg_binding_set(int type, int fingers, int dir, const char *action, const char *params);
+void             tpg_config_save(void);
+
+/* gesture engine (e_mod_gesture.c) */
+Eina_Bool        tpg_gesture_start(void);
+void             tpg_gesture_stop(void);
+Eina_Bool        tpg_gesture_running(void);
+
+/* settings dialog (e_mod_config.c) */
+E_Config_Dialog *e_int_config_tpgest(E_Container *con, const char *params);
+
+#endif
