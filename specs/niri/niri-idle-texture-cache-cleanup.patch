From 883b631a8d3aa99ad3346b28d2909a668512d188 Mon Sep 17 00:00:00 2001
From: n <n@e>
Date: Tue, 3 Nov 2026 19:19:23 +0000
Subject: [PATCH] Clean up renderer texture cache and flush the GPU queue on
 the fallback timer

The GLES renderer only drops imports of released client dmabufs at the start
of a frame, and deleted GL objects are only released by the driver once the
command stream is flushed. When little or nothing is drawn, dead imports and
deleted textures keep video memory alive. Run the cleanup from the existing
one-second timer and flush afterwards.
---
 src/backend/mod.rs | 25 +++++++++++++++++++++++++
 src/niri.rs        |  1 +
 2 files changed, 26 insertions(+)

diff --git a/src/backend/mod.rs b/src/backend/mod.rs
index 49fbc6b0..6ffaa5d1 100644
--- a/src/backend/mod.rs
+++ b/src/backend/mod.rs
@@ -5,6 +5,7 @@ use std::time::Duration;
 use niri_config::{Config, ModKey};
 use smithay::backend::allocator::dmabuf::Dmabuf;
 use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::backend::renderer::Renderer as _;
 use smithay::output::Output;
 use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
 
@@ -83,6 +84,30 @@ impl Backend {
         }
     }
 
+    /// Drops renderer-side imports of client buffers that clients have already released.
+    ///
+    /// The renderer normally does this at the start of every frame, so while nothing is being
+    /// drawn (idle desktop, monitors off) released client buffers would stay imported and keep
+    /// their video memory alive.
+    pub fn cleanup_texture_cache(&mut self) {
+        let _span = tracy_client::span!("Backend::cleanup_texture_cache");
+
+        self.with_primary_renderer(|renderer| {
+            if let Err(err) = renderer.cleanup_texture_cache() {
+                warn!("error cleaning up renderer texture cache: {err:?}");
+                return;
+            }
+
+            // Deleting a GL object only queues the release: the driver keeps the underlying
+            // buffer alive until the commands that might still reference it are submitted, which
+            // never happens while niri is idle and not rendering. Flush so that the memory is
+            // actually released.
+            if let Err(err) = renderer.with_context(|gl| unsafe { gl.Flush() }) {
+                warn!("error flushing renderer after texture cache cleanup: {err:?}");
+            }
+        });
+    }
+
     pub fn render(
         &mut self,
         niri: &mut Niri,
diff --git a/src/niri.rs b/src/niri.rs
index ec40e01c..cd57e96f 100644
--- a/src/niri.rs
+++ b/src/niri.rs
@@ -2426,6 +2426,7 @@ impl Niri {
                 Timer::from_duration(Duration::from_secs(1)),
                 |_, _, state| {
                     state.niri.send_frame_callbacks_on_fallback_timer();
+                    state.backend.cleanup_texture_cache();
                     TimeoutAction::ToDuration(Duration::from_secs(1))
                 },
             )
