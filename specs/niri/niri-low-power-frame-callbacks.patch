From 7dc6d33fd77c538f0f9cf4b2e07c378648e5aa57 Mon Sep 17 00:00:00 2001
From: niri-patch <patch@example.com>
Date: Sun, 1 Nov 2026 15:15:55 +0000
Subject: [PATCH] Add low-power-frame-callbacks debug option

Stop the once-a-second frame callback heartbeat to invisible windows and
throttle frame callbacks to unfocused windows in the overview, to reduce
CPU and GPU usage on low-end hardware.
---
 docs/wiki/Configuration:-Debug-Options.md | 17 +++++++++
 niri-config/src/debug.rs                  |  4 +++
 niri-config/src/lib.rs                    |  1 +
 src/niri.rs                               | 42 ++++++++++++++++-------
 4 files changed, 52 insertions(+), 12 deletions(-)

diff --git a/docs/wiki/Configuration:-Debug-Options.md b/docs/wiki/Configuration:-Debug-Options.md
index b43cfe3..ab44f36 100644
--- a/docs/wiki/Configuration:-Debug-Options.md
+++ b/docs/wiki/Configuration:-Debug-Options.md
@@ -33,6 +33,7 @@ debug {
     honor-xdg-activation-with-invalid-serial
     skip-cursor-only-updates-during-vrr
     deactivate-unfocused-windows
+    low-power-frame-callbacks
 }
 
 binds {
@@ -386,3 +387,19 @@ binds {
     Mod+Shift+Ctrl+D { debug-toggle-damage; }
 }
 ```
+
+### `low-power-frame-callbacks`
+
+Reduce the CPU and GPU usage of windows that you cannot interact with, which helps on low-end hardware.
+
+- Windows that are not visible (other workspaces, off-screen columns, hidden tabs, fully covered windows) no longer receive the once-a-second frame callback.
+  They still receive one when they need to respond to a configure event.
+- In the overview, unfocused windows receive frame callbacks at a much lower rate (about 5 per second on a 60 Hz output).
+
+Some clients rely on frame callbacks while hidden (for example, to run timers), and they may stall until shown again.
+
+```kdl
+debug {
+    low-power-frame-callbacks
+}
+```
diff --git a/niri-config/src/debug.rs b/niri-config/src/debug.rs
index c0779a4..14e8d00 100644
--- a/niri-config/src/debug.rs
+++ b/niri-config/src/debug.rs
