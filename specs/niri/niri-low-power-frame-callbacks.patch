index 329b766..4d4bbbd 100644
--- a/niri-config/src/lib.rs
+++ b/niri-config/src/lib.rs
@@ -2262,6 +2262,7 @@ mod tests {
                 honor_xdg_activation_with_invalid_serial: false,
                 deactivate_unfocused_windows: false,
                 skip_cursor_only_updates_during_vrr: false,
+                low_power_frame_callbacks: false,
             },
             workspaces: [
                 Workspace {
diff --git a/src/niri.rs b/src/niri.rs
index ec40e01..12a36d4 100644
--- a/src/niri.rs
+++ b/src/niri.rs
@@ -191,6 +191,10 @@ const CLEAR_COLOR_LOCKED: [f32; 4] = [0.3, 0.1, 0.1, 1.];
 // should be ~1.995 seconds.
 const FRAME_CALLBACK_THROTTLE: Option<Duration> = Some(Duration::from_millis(995));
 
+// In the low-power mode, unfocused windows in the overview only get a frame callback on every
+// Nth output refresh cycle (~5 fps at 60 Hz).
+const LOW_POWER_OVERVIEW_CALLBACK_DIVISOR: u32 = 12;
+
 pub struct Niri {
     pub config: Rc<RefCell<Config>>,
 
@@ -5053,13 +5057,24 @@ impl Niri {
 
         let frame_callback_time = get_monotonic_time();
 
+        let low_power = self.config.borrow().debug.low_power_frame_callbacks;
+        let window_throttle = if low_power {
+            None
+        } else {
+            FRAME_CALLBACK_THROTTLE
+        };
+        let throttle_unfocused = low_power
+            && self.layout.is_overview_open()
+            && sequence % LOW_POWER_OVERVIEW_CALLBACK_DIVISOR != 0;
+
         for mapped in self.layout.windows_for_output_mut(output) {
-            mapped.send_frame(
-                output,
-                frame_callback_time,
-                FRAME_CALLBACK_THROTTLE,
-                should_send,
-            );
+            // In the overview, windows are small thumbnails, so don't let unfocused ones redraw
+            // at the full refresh rate.
+            if throttle_unfocused && !mapped.is_focused() {
+                continue;
+            }
+
+            mapped.send_frame(output, frame_callback_time, window_throttle, should_send);
         }
 
         for surface in layer_map_for_output(output).layers() {
@@ -5120,13 +5135,16 @@ impl Niri {
 
         let frame_callback_time = get_monotonic_time();
 
+        // In the low-power mode, don't wake up hidden windows once a second. They still get
+        // frame callbacks when they need to respond to a configure.
+        let window_throttle = if self.config.borrow().debug.low_power_frame_callbacks {
+            None
+        } else {
+            FRAME_CALLBACK_THROTTLE
+        };
+
         self.layout.with_windows_mut(|mapped, _| {
-            mapped.send_frame(
-                output,
-                frame_callback_time,
-                FRAME_CALLBACK_THROTTLE,
-                |_, _| None,
-            );
+            mapped.send_frame(output, frame_callback_time, window_throttle, |_, _| None);
         });
 
         for (output, state) in self.output_state.iter() {
