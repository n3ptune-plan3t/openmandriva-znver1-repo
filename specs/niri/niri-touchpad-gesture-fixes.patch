+
+    pub fn view_offset_gesture_end_at(
+        &mut self,
+        is_touchpad: Option<bool>,
+        end_time: Option<Duration>,
+    ) -> Option<Output> {
         let monitors = match &mut self.monitor_set {
             MonitorSet::Normal { monitors, .. } => monitors,
             MonitorSet::NoOutputs { .. } => return None,
@@ -3710,7 +3726,7 @@ impl<W: LayoutElement> Layout<W> {
 
         for monitor in monitors {
             for ws in &mut monitor.workspaces {
-                if ws.view_offset_gesture_end(is_touchpad) {
+                if ws.view_offset_gesture_end_at(is_touchpad, end_time) {
                     return Some(monitor.output.clone());
                 }
             }
@@ -3756,12 +3772,20 @@ impl<W: LayoutElement> Layout<W> {
     }
 
     pub fn overview_gesture_end(&mut self) -> bool {
+        self.overview_gesture_end_at(None)
+    }
+
+    /// Ends the overview gesture.
+    ///
+    /// `end_time` is the timestamp of the event that ended the gesture, in the same time base as
+    /// the gesture updates. When `None`, the current time is used.
+    pub fn overview_gesture_end_at(&mut self, end_time: Option<Duration>) -> bool {
         let Some(OverviewProgress::Gesture(gesture)) = &mut self.overview_progress else {
             return false;
         };
 
         // Take into account any idle time between the last event and now.
-        let now = self.clock.now_unadjusted();
+        let now = end_time.unwrap_or_else(|| self.clock.now_unadjusted());
         gesture.tracker.push(0., now);
 
         let total_height = OVERVIEW_GESTURE_MOVEMENT;
