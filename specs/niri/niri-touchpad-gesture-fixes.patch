From ed10be60cf27f34244259fe04b887f0e93c2b358 Mon Sep 17 00:00:00 2001
From: n <n@e>
Date: Tue, 3 Nov 2026 19:20:11 +0000
Subject: [PATCH] Fix fast touchpad swipes being dropped or snapping back

Two problems made quick 3- and 4-finger swipes unreliable:

* Gesture end took its idle time from the current clock, not from the event.
  When the compositor is busy, the end event is handled late, so the idle gap
  dilutes (or, past the 150 ms history window, wipes out) the swipe velocity
  and the gesture snaps back instead of switching. Use the end event's own
  timestamp, via new *_gesture_end_at() variants; the old functions keep the
  clock behaviour for every other caller.

* A 3-finger swipe only starts after 16 units of movement, and everything
  before that was thrown away, so the gesture started from a standstill with
  the first part of the flick missing from its position and velocity. Buffer
  those deltas and feed them to the gesture when it starts. Also stop leaking
  the undecided updates to the client as swipe updates without a begin.
---
 src/input/mod.rs        | 105 ++++++++++++++++++++++++++++------------
 src/layout/mod.rs       |  30 ++++++++++--
 src/layout/monitor.rs   |  14 +++++-
 src/layout/scrolling.rs |  14 +++++-
 src/layout/workspace.rs |  11 ++++-
 src/niri.rs             |   7 +++
 6 files changed, 145 insertions(+), 36 deletions(-)

diff --git a/src/input/mod.rs b/src/input/mod.rs
index f1ad4932..0acaabfe 100644
--- a/src/input/mod.rs
+++ b/src/input/mod.rs
@@ -3746,6 +3746,7 @@ impl State {
 
         if event.fingers() == 3 {
             self.niri.gesture_swipe_3f_cumulative = Some((0., 0.));
+            self.niri.gesture_swipe_3f_pending.clear();
 
             // We handled this event.
             return;
@@ -3802,14 +3803,31 @@ impl State {
 
         let is_overview_open = self.niri.layout.is_overview_open();
 
+        let timestamp = Duration::from_micros(event.time());
+
+        // Deltas to feed to the gesture trackers. Normally just this event's delta, but when a
+        // 3-finger swipe gets decided, also everything that came in while it was undecided.
+        // (An empty Vec doesn't allocate, so the common case stays allocation-free.)
+        let mut replay = Vec::new();
+
         if let Some((cx, cy)) = &mut self.niri.gesture_swipe_3f_cumulative {
             *cx += delta_x;
             *cy += delta_y;
+            self.niri
+                .gesture_swipe_3f_pending
+                .push((delta_x, delta_y, uninverted_delta_y, timestamp));
 
             // Check if the gesture moved far enough to decide. Threshold copied from GNOME Shell.
             let (cx, cy) = (*cx, *cy);
-            if cx * cx + cy * cy >= 16. * 16. {
+            if cx * cx + cy * cy < 16. * 16. {
+                // Still undecided; this event is part of the 3-finger swipe, so don't let it leak
+                // to the client as an update without a begin.
+                return;
+            }
+
+            {
                 self.niri.gesture_swipe_3f_cumulative = None;
+                replay = std::mem::take(&mut self.niri.gesture_swipe_3f_pending);
 
                 if let Some(output) = self.niri.output_under_cursor() {
                     if cx.abs() > cy.abs() {
@@ -3839,40 +3857,54 @@ impl State {
             }
         }
 
-        let timestamp = Duration::from_micros(event.time());
+        let single = [(delta_x, delta_y, uninverted_delta_y, timestamp)];
+        let deltas: &[_] = if replay.is_empty() { &single } else { &replay };
 
         let mut handled = false;
-        let res = self
-            .niri
-            .layout
-            .workspace_switch_gesture_update(delta_y, timestamp, true);
-        if let Some(output) = res {
-            if let Some(output) = output {
-                self.niri.queue_redraw(&output);
+        let mut redraw_outputs = Vec::new();
+        let mut redraw_all = false;
+
+        for &(delta_x, delta_y, uninverted_delta_y, timestamp) in deltas {
+            let res = self
+                .niri
+                .layout
+                .workspace_switch_gesture_update(delta_y, timestamp, true);
+            if let Some(output) = res {
+                if let Some(output) = output {
+                    redraw_outputs.push(output);
+                }
+                handled = true;
             }
-            handled = true;
-        }
 
-        let res = self
-            .niri
-            .layout
-            .view_offset_gesture_update(delta_x, timestamp, true);
-        if let Some(output) = res {
-            if let Some(output) = output {
-                self.niri.queue_redraw(&output);
+            let res = self
+                .niri
+                .layout
+                .view_offset_gesture_update(delta_x, timestamp, true);
+            if let Some(output) = res {
+                if let Some(output) = output {
+                    redraw_outputs.push(output);
+                }
+                handled = true;
+            }
+
+            let res = self
+                .niri
+                .layout
+                .overview_gesture_update(-uninverted_delta_y, timestamp);
+            if let Some(redraw) = res {
+                if redraw {
+                    redraw_all = true;
+                }
+                handled = true;
             }
-            handled = true;
         }
 
-        let res = self
-            .niri
-            .layout
-            .overview_gesture_update(-uninverted_delta_y, timestamp);
-        if let Some(redraw) = res {
-            if redraw {
-                self.niri.queue_redraw_all();
+        if redraw_all {
+            self.niri.queue_redraw_all();
+        } else {
+            for output in redraw_outputs {
+                self.niri.queue_redraw(&output);
             }
-            handled = true;
         }
 
         if handled {
@@ -3897,21 +3929,34 @@ impl State {
 
     fn on_gesture_swipe_end<I: InputBackend>(&mut self, event: I::GestureSwipeEndEvent) {
         self.niri.gesture_swipe_3f_cumulative = None;
+        self.niri.gesture_swipe_3f_pending.clear();
+
+        // Use the time at which the fingers were lifted rather than the current time: when the
+        // compositor is busy, events are processed late, and the idle time between the last
+        // update and "now" would otherwise wash out the velocity of a fast swipe (or even drop
+        // all of its history) so that it snaps back instead of going through.
+        let end_time = Some(Duration::from_micros(event.time()));
 
         let mut handled = false;
-        let res = self.niri.layout.workspace_switch_gesture_end(Some(true));
+        let res = self
+            .niri
+            .layout
+            .workspace_switch_gesture_end_at(Some(true), end_time);
         if let Some(output) = res {
             self.niri.queue_redraw(&output);
             handled = true;
         }
 
-        let res = self.niri.layout.view_offset_gesture_end(Some(true));
+        let res = self
+            .niri
+            .layout
+            .view_offset_gesture_end_at(Some(true), end_time);
         if let Some(output) = res {
             self.niri.queue_redraw(&output);
             handled = true;
         }
 
-        let res = self.niri.layout.overview_gesture_end();
+        let res = self.niri.layout.overview_gesture_end_at(end_time);
         if res {
             self.niri.queue_redraw_all();
             handled = true;
