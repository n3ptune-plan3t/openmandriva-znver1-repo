%define debug_package %{nil}
%global __strip /bin/true

Name:           pake-gemini
Version:        3.18.0
Release:        1
Summary:        Gemini desktop app (Pake webview wrapper)
License:        MIT
Group:          Networking/WWW
URL:            https://github.com/tw93/Pake
Source0:        %{url}/releases/download/V%{version}/Gemini_x86_64.deb#/%{name}-%{version}.x86_64.deb
ExclusiveArch:  x86_64
BuildRequires:  binutils
BuildRequires:  tar
BuildRequires:  desktop-file-utils
# dlopen()ed at runtime for the tray icon, not visible to auto-requires
Requires:       lib64ayatana-appindicator3_1

%description
Lightweight desktop app generated by Pake that wraps https://gemini.google.com/
in a WebKitGTK window. Prebuilt upstream binary repacked from the official
Pake release; requires network access to Google's Gemini service.

%prep
%setup -q -c -T
ar x %{SOURCE0}
tar xf data.tar.*

%build
# prebuilt binary, nothing to build

%install
install -Dm755 usr/bin/pake-gemini %{buildroot}%{_bindir}/pake-gemini
install -Dm644 usr/share/icons/hicolor/512x512/apps/pake-gemini.png \
    %{buildroot}%{_iconsdir}/hicolor/512x512/apps/pake-gemini.png

cat > pake-gemini.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Gemini
Comment=Google Gemini desktop app
Exec=pake-gemini
Icon=pake-gemini
Categories=Network;WebBrowser;Utility;
MimeType=text/html;text/xml;application/xhtml+xml;
StartupNotify=true
StartupWMClass=pake-gemini
Terminal=false
EOF
install -Dm644 pake-gemini.desktop %{buildroot}%{_datadir}/applications/pake-gemini.desktop

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/pake-gemini.desktop

%files
%{_bindir}/pake-gemini
%{_datadir}/applications/pake-gemini.desktop
%{_iconsdir}/hicolor/512x512/apps/pake-gemini.png
