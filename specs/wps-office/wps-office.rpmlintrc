# The package is a prebuilt, self-contained vendor binary tree under /opt, repacked as-is.
# Note: the built package carries the build architecture (znver1 on the personal repo,
# x86_64 on stock builders), so every filter matches on any arch via \w+.
# Every filter below fires on the 12.x payload, so none is "unused".

# Every one of the ~19000 files under /opt trips this; expected for a vendor package.
addFilter(r"wps-office\.\w+: E: dir-or-file-in-opt")

# The bundled binaries need $ORIGIN-relative RUNPATH to find their own bundled .so files.
addFilter(r"wps-office\.\w+: E: binary-or-shlib-defines-rpath")

# Deprecated network calls inside vendor-bundled libcrypto/liblog4cpp -- not code we rebuild.
addFilter(r"wps-office\.\w+: [EW]: binary-or-shlib-calls-gethostbyname")

# Vendor ships two empty CSS files.
addFilter(r"wps-office\.\w+: E: zero-length ")

# Untouched vendor binaries: stripping is deliberately skipped (__os_install_post is nil).
addFilter(r"wps-office\.\w+: W: unstripped-binary-or-object")
addFilter(r"wps-office\.\w+: W: position-independent-executable-suggested")

# Vendor payload has many byte-identical files; we hardlink them (hardlink -c), which rpmlint
# reports as cross-directory hardlinks. The remaining duplicates (mimetypes/ vs apps/ icons) are the vendor's.
addFilter(r"wps-office\.\w+: W: cross-directory-hard-link")
addFilter(r"wps-office\.\w+: W: files-duplicate ")
addFilter(r"wps-office\.\w+: E: files-duplicated-waste")

# Vendor's own hidden file (.i18n-flow) inside the web UI resources.
addFilter(r"wps-office\.\w+: W: hidden-file-or-dir")

# The vendor wrappers have no man pages.
addFilter(r"wps-office\.\w+: W: no-manual-page-for-binary")

# No SPDX/rpmlint-recognized tag fits a closed-source EULA; see the License: comment in the spec.
addFilter(r"wps-office(-mime)?\.\w+: W: invalid-license (Custom|EULA)")
